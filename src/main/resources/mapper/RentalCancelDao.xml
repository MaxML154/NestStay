		SELECT  rc.* FROM `rental_cancel`  rc 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.neststay.entity.view.RentalCancelView" >
		SELECT * FROM `rental_cancel`  rc ${ew.customSqlSegment}
	</select>
	


