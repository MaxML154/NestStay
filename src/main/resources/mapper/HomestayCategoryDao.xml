<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neststay.dao.HomestayCategoryDao">

	<!-- 鍙牴鎹嚜宸辩殑闇€姹傦紝鏄惁瑕佷娇鐢?-->
    <resultMap type="com.neststay.entity.HomestayCategoryEntity" id="homestayCategoryMap">
        <result property="homestayCategory" column="homestay_category"/>
        <result property="image" column="image"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.neststay.entity.vo.HomestayCategoryVO" >
		SELECT * FROM `homestay_category`  hc         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.neststay.entity.vo.HomestayCategoryVO" >
		SELECT  hc.* FROM `homestay_category`  hc 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.neststay.entity.view.HomestayCategoryView" >

		SELECT  hc.* FROM `homestay_category`  hc 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.neststay.entity.view.HomestayCategoryView" >
		SELECT * FROM `homestay_category`  hc ${ew.customSqlSegment}
	</select>
	


</mapper>
