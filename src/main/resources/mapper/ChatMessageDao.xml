<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neststay.dao.ChatMessageDao">

	<!-- 鍙牴鎹嚜宸辩殑闇€姹傦紝鏄惁瑕佷娇鐢?-->
    <resultMap type="com.neststay.entity.ChatMessageEntity" id="chatMap">
        <result property="userId" column="user_id"/>
        <result property="adminId" column="admin_id"/>
        <result property="ask" column="ask"/>
        <result property="reply" column="reply"/>
        <result property="isReplied" column="is_replied"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.neststay.entity.vo.ChatMessageVO" >
		SELECT * FROM chat_message  chat         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.neststay.entity.vo.ChatMessageVO" >
		SELECT  chat.* FROM chat_message  chat 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.neststay.entity.view.ChatMessageView" >

		SELECT  chat.* FROM chat_message  chat 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.neststay.entity.view.ChatMessageView" >
		SELECT * FROM chat_message  chat ${ew.customSqlSegment}
	</select>
	


</mapper>
