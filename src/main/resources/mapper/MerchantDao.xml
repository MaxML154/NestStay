<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neststay.dao.MerchantDao">

	<!-- 鍙牴鎹嚜宸辩殑闇€姹傦紝鏄惁瑕佷娇鐢?-->
    <resultMap type="com.neststay.entity.MerchantEntity" id="merchantMap">
        <result property="merchantAccount" column="merchant_account"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="merchantName" column="merchant_name"/>
        <result property="merchantAddress" column="merchant_address"/>
        <result property="merchantPhone" column="merchant_phone"/>
        <result property="avatar" column="avatar"/>
        <result property="businessLicense" column="business_license"/>
        <result property="idCardFront" column="id_card_front"/>
        <result property="idCardBack" column="id_card_back"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.neststay.entity.vo.MerchantVO" >
		SELECT * FROM `merchant`  m         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.neststay.entity.vo.MerchantVO" >
		SELECT  m.* FROM `merchant`  m 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.neststay.entity.view.MerchantView" >

		SELECT  m.* FROM `merchant`  m 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.neststay.entity.view.MerchantView" >
		SELECT * FROM `merchant`  m ${ew.customSqlSegment}
	</select>
	


</mapper>
