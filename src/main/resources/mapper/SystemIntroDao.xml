<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neststay.dao.SystemIntroDao">

	<!-- 鍙牴鎹嚜宸辩殑闇€姹傦紝鏄惁瑕佷娇鐢?-->
    <resultMap type="com.neststay.entity.SystemIntroEntity" id="systemIntroMap">
        <result property="title" column="title"/>
        <result property="subtitle" column="subtitle"/>
        <result property="content" column="content"/>
        <result property="picture1" column="picture1"/>
        <result property="picture2" column="picture2"/>
        <result property="picture3" column="picture3"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.neststay.entity.vo.SystemIntroVO" >
		SELECT * FROM `system_intro`  systemintro         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.neststay.entity.vo.SystemIntroVO" >
		SELECT  systemintro.* FROM `system_intro`  systemintro 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.neststay.entity.view.SystemIntroView" >

		SELECT  systemintro.* FROM `system_intro`  systemintro 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.neststay.entity.view.SystemIntroView" >
		SELECT * FROM `system_intro`  systemintro ${ew.customSqlSegment}
	</select>
	


</mapper>
