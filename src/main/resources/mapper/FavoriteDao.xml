<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neststay.dao.FavoriteDao">

	<!-- 鍙牴鎹嚜宸辩殑闇€姹傦紝鏄惁瑕佷娇鐢?-->
    <resultMap type="com.neststay.entity.FavoriteEntity" id="favoriteMap">
        <result property="userId" column="user_id"/>
        <result property="refid" column="refid"/>
        <result property="tableName" column="table_name"/>
        <result property="name" column="display_name"/>
        <result property="picture" column="picture"/>
        <result property="type" column="type"/>
        <result property="intelType" column="intel_type"/>
        <result property="remark" column="remark"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.neststay.entity.vo.FavoriteVO" >
		SELECT * FROM `favorite`  storeup         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.neststay.entity.vo.FavoriteVO" >
		SELECT  storeup.* FROM `favorite`  storeup 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.neststay.entity.view.FavoriteView" >

		SELECT  storeup.* FROM `favorite`  storeup 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.neststay.entity.view.FavoriteView" >
		SELECT * FROM `favorite`  storeup ${ew.customSqlSegment}
	</select>
	


</mapper>
