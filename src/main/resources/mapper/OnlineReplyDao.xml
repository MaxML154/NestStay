<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neststay.dao.OnlineReplyDao">

	<!-- 鍙牴鎹嚜宸辩殑闇€姹傦紝鏄惁瑕佷娇鐢?-->
    <resultMap type="com.neststay.entity.OnlineReplyEntity" id="onlineReplyMap">
        <result property="homestayName" column="homestay_name"/>
        <result property="replyImage" column="reply_image_url"/>
        <result property="replyVideo" column="reply_video_url"/>
        <result property="replyContent" column="reply_content"/>
        <result property="replyTime" column="reply_time"/>
        <result property="merchantAccount" column="merchant_account"/>
        <result property="merchantName" column="merchant_name"/>
        <result property="account" column="account"/>
        <result property="realName" column="real_name"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.neststay.entity.vo.OnlineReplyVO" >
		SELECT * FROM `online_reply`  `or`
	        ${ew.customSqlSegment}
		</select>

		<select id="selectVO"
			resultType="com.neststay.entity.vo.OnlineReplyVO" >
			SELECT  `or`.* FROM `online_reply`  `or`
	 		${ew.customSqlSegment}
		</select>

	    <select id="selectListView"
			resultType="com.neststay.entity.view.OnlineReplyView" >

			SELECT  `or`.* FROM `online_reply`  `or`
	        ${ew.customSqlSegment}
		</select>

		<select id="selectView"
			resultType="com.neststay.entity.view.OnlineReplyView" >
			SELECT * FROM `online_reply`  `or` ${ew.customSqlSegment}
		</select>



</mapper>