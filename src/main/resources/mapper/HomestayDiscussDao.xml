<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neststay.dao.HomestayDiscussDao">

	<!-- 鍙牴鎹嚜宸辩殑闇€姹傦紝鏄惁瑕佷娇鐢?-->
    <resultMap type="com.neststay.entity.view.HomestayDiscussView" id="homestayDiscussViewMap">
        <id property="id" column="id"/>
        <result property="refid" column="refid"/>
        <result property="userId" column="user_id"/>
        <result property="avatarUrl" column="avatar_url"/>
        <result property="nickname" column="nickname"/>
        <result property="content" column="content"/>
        <result property="score" column="credit_score"/>
        <result property="scoreStay" column="score_stay"/>
        <result property="scoreService" column="score_service"/>
        <result property="scoreQuality" column="score_quality"/>
        <result property="orderNumber" column="order_number"/>
        <result property="reply" column="reply"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.neststay.entity.vo.HomestayDiscussVO" >
		SELECT * FROM `homestay_discuss`  hd         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.neststay.entity.vo.HomestayDiscussVO" >
		SELECT  hd.* FROM `homestay_discuss`  hd 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultMap="homestayDiscussViewMap" >

		SELECT  hd.* FROM `homestay_discuss`  hd 	        
        ${ew.customSqlSegment}
    </select>
	
	<select id="selectView"
		resultMap="homestayDiscussViewMap" >
		SELECT * FROM `homestay_discuss`  hd ${ew.customSqlSegment}
	</select>
	


</mapper>
