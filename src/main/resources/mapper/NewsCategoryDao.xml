<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.neststay.dao.NewsCategoryDao">

	<!-- 鍙牴鎹嚜宸辩殑闇€姹傦紝鏄惁瑕佷娇鐢?-->
    <resultMap type="com.neststay.entity.NewsCategoryEntity" id="newsCategoryMap">
        <result property="typeName" column="type_name"/>
    </resultMap>

	<select id="selectListVO"
		resultType="com.neststay.entity.vo.NewsCategoryVO" >
		SELECT * FROM `news_category`  newstype         
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectVO"
		resultType="com.neststay.entity.vo.NewsCategoryVO" >
		SELECT  newstype.* FROM `news_category`  newstype 	
 		${ew.customSqlSegment}
	</select>

    <select id="selectListView"
		resultType="com.neststay.entity.view.NewsCategoryView" >

		SELECT  newstype.* FROM `news_category`  newstype 	        
        ${ew.customSqlSegment}
	</select>
	
	<select id="selectView"
		resultType="com.neststay.entity.view.NewsCategoryView" >
		SELECT * FROM `news_category`  newstype ${ew.customSqlSegment}
	</select>
	


</mapper>
